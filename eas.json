{
  "cli": {
    "version": ">= 27.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "disabled": false,
        "key": "preview-cache",
        "paths": ["android", "ios"]
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EAS_USE_CACHE": "1"
      },
      "cache": {
        "disabled": false,
        "key": "production-cache"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal" // or "alpha", "beta", "production"
      }
    }
  }
}
